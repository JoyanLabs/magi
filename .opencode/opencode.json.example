# API Keys - NO SUBIR AL REPOSITORIO
# Copia este archivo a opencode.json y reemplaza los valores

{
	"$schema": "https://opencode.ai/config.json",
	"mcp": {
		"context7": {
			"type": "remote",
			"url": "https://mcp.context7.com/mcp",
			"headers": {
				"CONTEXT7_API_KEY": "TU_API_KEY_DE_CONTEXT7"
			},
			"enabled": true
		},
		"engram": {
			"command": ["engram", "mcp"],
			"enabled": true,
			"type": "local"
		},
		"notebooklm": {
			"type": "local",
			"command": ["notebooklm-mcp"],
			"enabled": true
		}
	},
	"plugin": ["opencode-gemini-auth@latest"],
	"agent": {
		"default": {
			"mode": "primary",
			"description": "Default assistant for general coding tasks",
			"prompt": "You are a helpful coding assistant. Use skills from the project when needed.",
			"tools": {
				"read": true,
				"write": true,
				"edit": true
			}
		}
	}
}

{
  "$schema": "https://magi.framework/checklist-documentos.json",
  "version": "1.0.0",
  "descripcion": "Checklist de documentos obligatorios para iniciar un proyecto",
  "documentos_obligatorios": [
    {
      "id": "contrato",
      "nombre": "Contrato",
      "tipo": "legal",
      "fuente": "cliente",
      "requiere_optimizacion": true,
      "descripcion": "Contrato firmado con el cliente",
      "template": "contrato",
      "prioridad": 1
    },
    {
      "id": "propuesta",
      "nombre": "Propuesta Comercial",
      "tipo": "comercial",
      "fuente": "nosotros",
      "requiere_optimizacion": true,
      "descripcion": "Propuesta que ganó el proyecto",
      "template": "propuesta",
      "prioridad": 2
    },
    {
      "id": "diagnostico",
      "nombre": "Diagnóstico",
      "tipo": "analisis",
      "fuente": "consultor",
      "requiere_optimizacion": true,
      "descripcion": "Análisis de situación actual del cliente",
      "template": "diagnostico",
      "prioridad": 3
    },
    {
      "id": "plan-implementacion",
      "nombre": "Plan de Implementación",
      "tipo": "planificacion",
      "fuente": "nosotros",
      "requiere_optimizacion": true,
      "descripcion": "Plan de trabajo firmado con el cliente",
      "template": "plan-impl",
      "prioridad": 4
    },
    {
      "id": "reuniones",
      "nombre": "Levantamiento de Información",
      "tipo": "analisis",
      "fuente": "reunion",
      "requiere_optimizacion": true,
      "descripcion": "Transcripciones de reuniones con el cliente",
      "template": "resumen-reuniones",
      "prioridad": 5
    },
    {
      "id": "resumen-ejecutivo",
      "nombre": "Resumen Ejecutivo",
      "tipo": "sintesis",
      "fuente": "generado",
      "requiere_optimizacion": true,
      "descripcion": "Síntesis de todos los documentos para consulta rápida",
      "template": "resumen-ejecutivo",
      "prioridad": 6
    }
  ],
  "reglas": {
    "validacion_obligatoria": true,
    "human_in_the_loop": "solo_en_creacion",
    "docs_minimos_para_trabajar": ["contrato", "propuesta", "diagnostico"],
    "docs_necesarios_para_sprint": ["reuniones", "resumen-ejecutivo"]
  }
}

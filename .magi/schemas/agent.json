{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://magi.framework/agent.json",
  "title": "MAGI Agent Schema",
  "description": "Schema para definición de agentes en MAGI Framework",
  "type": "object",
  "required": ["id", "name", "role", "model"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Identificador único del agente",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "name": {
      "type": "string",
      "description": "Nombre display del agente",
      "minLength": 1,
      "maxLength": 64
    },
    "description": {
      "type": "string",
      "description": "Descripción del propósito del agente"
    },
    "role": {
      "type": "string",
      "enum": ["leader", "worker"],
      "description": "Rol del agente: leader (orquestador) o worker (especialista)"
    },
    "specialty": {
      "type": "string",
      "description": "Especialidad del agente (ej: documentacion, arquitectura, scrum)"
    },
    "model": {
      "type": "string",
      "description": "Modelo LLM a usar (ej: opencode/minimax-m2.5-free)"
    },
    "temperature": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.3,
      "description": "Temperatura del modelo"
    },
    "systemPrompt": {
      "type": "string",
      "description": "System prompt personalizado del agente"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Nombre del skill"
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "autoInvoke": {
            "type": "boolean",
            "default": false,
            "description": "Si el skill se invoca automáticamente"
          }
        }
      },
      "description": "Lista de skills disponibles para el agente"
    },
    "mcp": {
      "type": "object",
      "description": "Configuraciones MCP disponibles para el agente",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "config": {
            "type": "object",
            "description": "Configuración específica del MCP"
          }
        }
      }
    },
    "permissions": {
      "type": "object",
      "description": "Permisos del agente",
      "properties": {
        "fileAccess": {
          "type": "object",
          "properties": {
            "allowed": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Patrones de archivos permitidos"
            },
            "denied": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Patrones de archivos denegados"
            }
          }
        },
        "commands": {
          "type": "object",
          "properties": {
            "allowed": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Comandos permitidos"
            },
            "denied": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Comandos denegados"
            }
          }
        },
        "network": {
          "type": "object",
          "properties": {
            "allowed": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Dominios/IPs permitidos"
            }
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "description": "Recursos asignados al agente",
      "properties": {
        "memory": {
          "type": "string",
          "description": "Límite de memoria (ej: 512MB)"
        },
        "cpu": {
          "type": "string",
          "description": "Límite de CPU (ej: 0.5)"
        },
        "timeout": {
          "type": "integer",
          "description": "Timeout en segundos para tareas"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["idle", "working", "error", "stopped"],
      "default": "idle",
      "description": "Estado actual del agente"
    },
    "metadata": {
      "type": "object",
      "description": "Metadatos adicionales",
      "additionalProperties": true
    }
  }
}
